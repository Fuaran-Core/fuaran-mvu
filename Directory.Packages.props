<Project>
  <PropertyGroup>
    <!-- The one version every Fuaran.Core.* package is pinned at: one property per producing repository (the
         estate's version-pinning rule), so the pins cannot drift apart. Public packages on nuget.org; the restore
         path is declared public in Directory.Build.props. Phase 648; raised from 0.43.0 to 0.44.1 in Phase 719, the
         Core version Fuaran.ClientEffects references, so the browser package's closure holds one Core version. -->
    <FuaranCoreVersion>0.44.1</FuaranCoreVersion>
    <!-- The client effect vocabulary (Fuaran.MVU.Browser, Phase 719, DECISIONS.md D30): its own repository, so its own
         property. Public on nuget.org. -->
    <FuaranClientEffectsVersion>0.1.0</FuaranClientEffectsVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The kernel references FSharp.Core and nothing else. -->
    <PackageVersion Include="FSharp.Core" Version="10.1.300" />
    <!-- The runtime's gate (Phase 648): Core's capability registry, policy gate and grant, and the guarded
         submission and approval over the AI surface. The kernel references neither. -->
    <PackageVersion Include="Fuaran.Core.Function" Version="$(FuaranCoreVersion)" />
    <PackageVersion Include="Fuaran.Core.AiSurface" Version="$(FuaranCoreVersion)" />
    <!-- The optional session log (Fuaran.MVU.Session, Phase 649): Core's op-stream. Already in the closure of the two
         above; pinned here because the session package references it directly. -->
    <PackageVersion Include="Fuaran.Core.OpStream" Version="$(FuaranCoreVersion)" />
    <!-- The React adapter (Fuaran.MVU.React, Phase 720, DECISIONS.md D29): React's own F# types, not Feliz. Feliz is
         built on Fable.React.Types, so an element Feliz builds IS this package's `ReactElement` and crosses the
         element-view bridge with no conversion. Fable.Core for the adapter's imports and its browser timing, at the
         version the published Fuaran.Core.* packages already require. -->
    <PackageVersion Include="Fable.Core" Version="5.0.0" />
    <PackageVersion Include="Fable.React.Types" Version="18.4.0" />
    <!-- The browser package (Fuaran.MVU.Browser, Phase 719, DECISIONS.md D30): the client effect vocabulary it performs,
         declared once in its own library, which references Fuaran.Core.Wire at FuaranCoreVersion. -->
    <PackageVersion Include="Fuaran.ClientEffects" Version="$(FuaranClientEffectsVersion)" />
    <!-- TEST-ONLY. -->
    <PackageVersion Include="Expecto" Version="10.2.3" />
  </ItemGroup>
</Project>
